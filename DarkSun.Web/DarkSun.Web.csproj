<Project Sdk="Microsoft.NET.Sdk.Web">
    <!-- DEPRECATED legacy Blazor prototype - see DEPRECATED.md. Kept for reference only. -->
    <ItemGroup>
        <ProjectReference Include="..\DarkSun.Application\DarkSun.Application.csproj" />
        <ProjectReference Include="..\DarkSun.Domain\DarkSun.Domain.csproj" />
        <ProjectReference Include="..\DarkSun.Infrastructure\DarkSun.Infrastructure.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="BCrypt.Net-Next" Version="4.1.0" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="8.0.0" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" Version="8.0.0" />
        <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
        <PackageReference Include="MudBlazor" Version="9.4.0" />
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Properties\Resources.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Resources.resx</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Properties\Resources.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>Resources.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>

    <!-- Legacy Dockerfile lives in the solution root -->
    <ItemGroup>
        <None Include="..\Dockerfile">
            <Link>Dockerfile</Link>
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        </None>
        <None Include="..\.dockerignore">
            <Link>.dockerignore</Link>
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- Secrets come from `dotnet user-secrets` or environment variables only; never commit them. -->
        <UserSecretsId>ccb7ea55-863c-4f5d-8dd8-13e152caffbb</UserSecretsId>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <DockerfilePath>..\Dockerfile</DockerfilePath>
    </PropertyGroup>

</Project>
