# Copy to .env for local Prisma / Next.js. Never commit .env.

# --- Content + character database: MariaDB in the bunker (see docs/DATABASE.md) ---
# Charset/collation are set on the database (utf8mb4 / utf8mb4_unicode_ci).
DATABASE_URL="mysql://ssr:CHANGEME@bunker-host:3306/savage_sun_rising"
# Local throwaway MariaDB (`docker compose --profile localdb up -d`, repo root):
# DATABASE_URL="mysql://ssr:ssr-local@127.0.0.1:3306/savage_sun_rising"

# --- Corpora (read-only, not in this repo) used by `npm run db:import` ---
# Defaults when unset, relative to the folder holding this repo:
#   ../Depp-Magic/Reference/spell-powers-official-v3.6*.json  (newest by name/mtime)
#   ../complete-compendium/static/tools/monster_index.json
# SSR_SPELLS_FILE="C:\\jdlcode\\repos\\Depp-Magic\\Reference\\spell-powers-official-v3.6.2.json"
# SSR_MONSTERS_FILE="C:\\jdlcode\\repos\\complete-compendium\\static\\tools\\monster_index.json"

# --- Auth.js (next-auth v5) + Authentik OIDC - see docs/AUTH.md ---
# Random 32+ byte secret that encrypts the session cookie: `npx auth secret`
# or `openssl rand -base64 33`. Different per environment; never commit it.
AUTH_SECRET="replace-with-random-secret"
# Public base URL of this app (what the browser sees). Behind cloudflared this
# is the public https hostname, not the internal host:port.
AUTH_URL="http://localhost:3000"
# Trust X-Forwarded-Host/Proto from the reverse proxy (cloudflared).
AUTH_TRUST_HOST=true
# From the Authentik OAuth2/OpenID provider (Client type: Confidential).
AUTH_AUTHENTIK_ID="replace-with-authentik-client-id"
AUTH_AUTHENTIK_SECRET="replace-with-authentik-client-secret"
# Exactly the provider's "OpenID Configuration Issuer", including trailing slash.
AUTH_AUTHENTIK_ISSUER="https://authentik.example.com/application/o/savage-sun-rising/"
