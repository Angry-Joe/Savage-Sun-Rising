// Prisma schema for the Savage Sun Rising product app.
// Database: MariaDB 10.11+/11.x via Prisma's `mysql` provider (MariaDB is a
// supported MySQL-compatible target). See docs/DATABASE.md.
//
// Content corpora (Depp-Magic spells/psionics v3.6.x, complete-compendium
// monsters) are rebuildable artifacts imported by scripts/import-corpora.mjs.
// Full source records live in `data` (JSON); filterable fields are promoted to
// plain columns because MariaDB has no array columns and no JSON GIN indexes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Character {
  id        String   @id @default(cuid())
  /// Authentik OIDC subject claim (`sub`) of the owning user.
  /// Nullable so local/dev rows predate auth; enforce NOT NULL once the
  /// Authentik provider is live and existing rows are backfilled.
  ownerId   String?  @db.VarChar(191)
  name      String   @db.VarChar(255)
  /// Full character document (allowedCampaignSettings, overlay bags, powers, etc.)
  sheet     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, updatedAt])
  @@map("characters")
}

/// Provenance for each corpus import - which file, which schema version, how
/// many rows. One row per import run; the newest row describes the live data.
model Corpus {
  id            String   @id @default(cuid())
  /// "spells" | "monsters"
  kind          String   @db.VarChar(32)
  sourceFile    String   @db.VarChar(512)
  schemaVersion String?  @db.VarChar(32)
  dateUpdated   String?  @db.VarChar(32)
  rowCount      Int
  inserted      Int      @default(0)
  updated       Int      @default(0)
  pruned        Int      @default(0)
  /// Vocabularies shipped with the corpus (rulesets, campaignSettings) + counts
  meta          Json
  importedAt    DateTime @default(now())

  @@index([kind, importedAt])
  @@map("corpora")
}

/// One row per spell or psionic power, Depp-Magic v3.6 shape.
/// v3.6.x ids are unique across both arrays.
model SpellPower {
  /// Depp-Magic id, e.g. "spell_wakefulness_2e" / "psionic_probe_2e"
  id                      String   @id @db.VarChar(191)
  name                    String   @db.VarChar(255)
  /// "spell" | "psionic"
  kind                    String   @db.VarChar(16)
  /// arcane | divine | psionic
  tradition               String?  @db.VarChar(16)
  level                   Int?
  /// Spells only
  school                  String?  @db.VarChar(128)
  /// Psionics only
  discipline              String?  @db.VarChar(64)
  tier                    String?  @db.VarChar(32)
  /// N/A | Att | Def (psionics)
  combatMode              String?  @db.VarChar(8)
  /// Source arrays kept as JSON for display/export
  classes                 Json
  allowedRulesets         Json
  allowedCampaignSettings Json
  /// Promoted flags for indexed filtering (derived from the arrays above)
  isWizard                Boolean  @default(false)
  isPriest                Boolean  @default(false)
  rs2e                    Boolean  @default(false)
  rs2eRev                 Boolean  @default(false)
  rs5e                    Boolean  @default(false)
  /// allowedCampaignSettings contains "ds"
  csDs                    Boolean  @default(false)
  /// campaignSettings.ds overlay bag present
  dsOverlay               Boolean  @default(false)
  verified                Boolean  @default(false)
  /// Importer data-quality flags. Empty array = clean row.
  suspect                 Json
  summary                 String?  @db.Text
  /// Full v3.6 record, including the `rulesets` and `campaignSettings` overlay bags
  data                    Json
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([kind, name])
  @@index([kind, level])
  @@index([kind, isWizard, level])
  @@index([kind, isPriest, level])
  @@index([school])
  @@index([discipline, tier])
  @@index([combatMode])
  @@index([verified])
  @@map("spell_powers")
}

/// One row per monster_index entry from complete-compendium.
model Monster {
  /// Stable slug of the compendium `key` (suffixed -2, -3 on collisions)
  id          String   @id @db.VarChar(191)
  /// Row id in monster_index.json
  sourceId    Int
  name        String   @db.VarChar(255)
  /// Setting name, e.g. "Dark Sun"
  setting     String?  @db.VarChar(128)
  /// Setting acronym, e.g. "ds"
  settingCode String?  @db.VarChar(16)
  /// allowedSettings contains "ds"
  isAthas     Boolean  @default(false)
  psionic     Boolean  @default(false)
  hitDice     Float?
  armorClass  Int?
  xp          Int?
  size        String?  @db.VarChar(64)
  corpus      String   @db.VarChar(64)
  /// Full monster_index row (statblock `sb`, derived `d`, sources)
  data        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isAthas, name])
  @@index([name])
  @@index([settingCode])
  @@map("monsters")
}
